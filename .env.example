# Local development defaults. Copy to .env and adjust.
# For the deployed settings, see docs/deployment.md.

DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Origins allowed to POST to the Django admin. Needs the scheme. Only matters
# once the site is behind HTTPS; leave empty locally.
CSRF_TRUSTED_ORIGINS=

# Proxies in front of this app, for DRF throttle IP detection. Left unset,
# a client can spoof X-Forwarded-For and dodge the password-reset rate limit.
# Defaults to 1 (PythonAnywhere's single nginx proxy) — leave commented out.
# NUM_PROXIES=1

# Password-reset rate limit, per IP. Only applied when DJANGO_DEBUG=False —
# locally the endpoint is never throttled. Defaults to 20/hour.
# PASSWORD_RESET_THROTTLE_RATE=20/hour

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
SHIPPING_FLAT_RATE=30.00
FREE_SHIPPING_THRESHOLD=500.00
DEFAULT_CURRENCY=EGP
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Where uploaded product images live, and the URL they are served from.
# Leave both unset locally. In production set MEDIA_URL to an *absolute* URL on
# the API's own domain (see the comment in settings.py) and MEDIA_ROOT to a path
# outside the deployed source tree, so a redeploy cannot wipe the uploads.
# MEDIA_ROOT=/home/YOURUSER/jory-data/media
# MEDIA_URL=https://YOURUSER.pythonanywhere.com/media/

# Both only take effect when DJANGO_DEBUG=False. Leave off unless the host does
# not already force HTTPS at the edge.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Outbound email. SMTP is NOT an option on the deployed tier (PythonAnywhere
# free accounts cannot open outbound SMTP connections), so production sends
# through Brevo's HTTPS API. Leave EMAIL_BACKEND unset locally — it defaults to
# the console backend whenever DJANGO_DEBUG is True.
# EMAIL_BACKEND=
BREVO_API_KEY=
# Production MUST set this to a Brevo-verified sender address, or every send
# fails (silently for the shopper — see the ImproperlyConfigured guard in
# settings.py, which only catches a *missing* BREVO_API_KEY, not a rejected
# sender). The placeholder below is for local console-backend use only.
# DEFAULT_FROM_EMAIL=Jory <no-reply@jory.test>

# The storefront's public origin. Every emailed link is built against this.
FRONTEND_URL=http://localhost:4200
